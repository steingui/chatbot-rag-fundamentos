rules_version = '2';

// INF-403 — Acesso ao Firestore é feito exclusivamente pelo backend via
// Firebase Admin SDK (que ignora estas regras). Clientes web/mobile não têm
// acesso direto ao banco, garantindo isolamento total por padrão.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
